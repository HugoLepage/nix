<!-- Shared gradients and icon symbols, referenced by id from the markup and from the UI scripts. -->
<svg class="svg-defs" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="grad-ice" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="0.3" stop-color="#bdf3ff" />
      <stop offset="0.65" stop-color="#4db8ff" />
      <stop offset="1" stop-color="#3b82f6" />
    </linearGradient>
    <!-- User-space units: the logo contains perfectly vertical strokes, whose bounding box has no width. -->
    <linearGradient id="grad-logo" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="230" y2="100">
      <stop offset="0" stop-color="#eafcff" />
      <stop offset="0.35" stop-color="#9ee7ff" />
      <stop offset="0.7" stop-color="#4db8ff" />
      <stop offset="1" stop-color="#3b82f6" />
    </linearGradient>
    <!-- Enemy bodies: the same fills the canvas paints them with (fx-foes.js), lit from the top left. -->
    <radialGradient id="grad-qix" fx="0.41" fy="0.39">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="0.16" stop-color="#ffc8f2" />
      <stop offset="0.44" stop-color="#ff4fd8" />
      <stop offset="0.8" stop-color="#a855f7" />
      <stop offset="1" stop-color="#4c1d95" />
    </radialGradient>
    <!-- User space, centred on the symbol: the colour runs out along each spike to a white-hot tip. -->
    <radialGradient id="grad-chipper-spikes" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="10.6">
      <stop offset="0.45" stop-color="#8f1430" />
      <stop offset="0.7" stop-color="#ff5a3c" />
      <stop offset="0.92" stop-color="#ffd2bf" />
      <stop offset="1" stop-color="#ffffff" />
    </radialGradient>
    <radialGradient id="grad-chipper-core" fx="0.34" fy="0.31">
      <stop offset="0" stop-color="#ff8a6a" />
      <stop offset="0.35" stop-color="#d81b3c" />
      <stop offset="0.75" stop-color="#6e0a22" />
      <stop offset="1" stop-color="#3a0412" />
    </radialGradient>
    <linearGradient id="grad-seeker" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f4fff8" />
      <stop offset="0.35" stop-color="#c9f9dc" />
      <stop offset="0.75" stop-color="#7fe0a6" />
      <stop offset="1" stop-color="#46b878" />
    </linearGradient>
    <radialGradient id="grad-spawner" fx="0.33" fy="0.3">
      <stop offset="0" stop-color="#9a72e0" />
      <stop offset="0.3" stop-color="#4a2588" />
      <stop offset="0.75" stop-color="#1f0b40" />
      <stop offset="1" stop-color="#0e0424" />
