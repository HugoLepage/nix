    <radialGradient id="grad-port">
      <stop offset="0" stop-color="#ffe0f8" />
      <stop offset="0.3" stop-color="#ff4fd8" />
      <stop offset="0.7" stop-color="#9b5cff" />
      <stop offset="1" stop-color="#2c0b5a" />
    </radialGradient>
  </defs>

