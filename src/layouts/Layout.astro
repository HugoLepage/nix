---
import '../styles/global.css';
import '../styles/ui.css';
import '../styles/howto.css';
import '../styles/game.css';

// BASE_URL keeps `base` exactly as configured ('/nix'), so normalise it to end with a slash.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no" />
    <title>Nix</title>
    <meta name="description" content="Draw the line. Claim the board. A modern take on Qix." />
    <meta name="theme-color" content="#04060c" />
    <meta name="color-scheme" content="dark" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Nix" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
  </head>
  <body>
    <slot />
    <noscript><p class="noscript">Nix needs JavaScript.</p></noscript>
  </body>
</html>
