---
import Layout from '../layouts/Layout.astro';
import Defs from '../components/Defs.astro';
import Backdrop from '../components/Backdrop.astro';
import BootScreen from '../components/BootScreen.astro';
import LoginScreen from '../components/LoginScreen.astro';
import MenuScreen from '../components/MenuScreen.astro';
import ChaptersScreen from '../components/ChaptersScreen.astro';
import HowtoScreen from '../components/HowtoScreen.astro';
import GameScreen from '../components/GameScreen.astro';
---

<Layout>
  <div id="app" data-screen="boot">
    <Defs />
    <Backdrop />
    <BootScreen />
    <LoginScreen />
    <MenuScreen />
    <ChaptersScreen />
    <HowtoScreen />
    <GameScreen />
  </div>

  <script>
    import '../scripts/main.js';
  </script>
</Layout>
